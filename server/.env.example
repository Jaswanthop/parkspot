# ---------------------------------------------------------------------------
# ParkSpot server environment
# Copy this file to server/.env and adjust the values.
# ---------------------------------------------------------------------------

# HTTP port used by the API and the built React app.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string. Use a local server or a MongoDB Atlas cluster.
# Atlas example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/parkspot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/parkspot

# Signing key for JWTs. Use a long random string in production.
# The server refuses to start in production if this is empty.
JWT_SECRET=replace-with-a-long-random-string

# Token lifetime (vercel/ms format).
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API cross-origin.
# In production the SPA and API share an origin, so this is mostly for local dev.
CLIENT_ORIGIN=http://localhost:5173

# Admin account created on first startup if it does not already exist.
ADMIN_EMAIL=admin@parkspot.dev
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=ParkSpot Admin

# Create the demo driver and sample bookings. Defaults to true outside production.
# Set to false for a clean production database.
SEED_DEMO=true
